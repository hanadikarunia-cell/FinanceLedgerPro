# FinanceLedgerPro — free-tier stack environment variables.
# Copy the relevant subset into Render (API service env vars), Vercel (frontend env
# vars), and GitHub Actions (repo secrets, for the scheduled Sheets-sync workflow).
# See docs/free-tier-deployment.md for the full setup walkthrough.
# Never commit a real .env file with actual values.

# ---- API (Render) ---------------------------------------------------------------

# Supabase project (Settings > Database > Connection string > URI, "Session pooler"
# recommended for Render's free tier since it's IPv4-compatible).
POSTGRES_CONNECTION_STRING=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true

# Supabase project (Settings > API). No JWT secret is needed — the API validates
# access tokens against Supabase's public JWKS endpoint (derived from SUPABASE_URL),
# since Supabase signs tokens with an asymmetric (ES256) key, not a shared secret.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
SUPABASE_STORAGE_BUCKET=attachments

# Resend (resend.com) — free tier.
RESEND_API_KEY=<resend-api-key>
RESEND_SENDER_ADDRESS=DoNotReply@yourdomain.com

# Google Sheets sync — optional, leave both blank to skip. Render's free tier has no
# Background Worker, so this runs via POST /api/v1/admin/sync/google-sheets on the API
# itself (see the GitHub Actions section below), not a separate worker process.
GOOGLE_SHEET_ID=<spreadsheet-id>
# The raw downloaded service-account JSON. Render's env var fields accept multi-line
# text as-is; a literal .env file needs it collapsed to one line/escaped instead.
GOOGLE_SHEETS_CREDENTIALS_JSON=<service-account-json>

# CORS — the deployed Vercel frontend URL.
FRONTEND_ORIGIN=https://your-app.vercel.app

# Render injects this automatically — no need to set it yourself.
# PORT=10000

# ---- Web frontend (Vercel) -----------------------------------------------------

VITE_API_BASE_URL=https://your-api.onrender.com

# ---- Mobile (Expo) --------------------------------------------------------------

EXPO_PUBLIC_API_BASE_URL=https://your-api.onrender.com

# ---- GitHub Actions (repo Settings > Secrets and variables > Actions) -----------
# Drives .github/workflows/sync-google-sheets.yml, which calls the admin sync
# endpoint on a schedule in place of a dedicated worker process. Use a dedicated
# Manager user created just for this, not your own login.

SYNC_API_BASE_URL=https://your-api.onrender.com
SYNC_USER_EMAIL=sync-bot@yourdomain.com
SYNC_USER_PASSWORD=<a-strong-generated-password>
